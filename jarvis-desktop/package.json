{
  "name": "jarvis-desktop",
  "productName": "Desktop Companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "smoke": "node scripts/run-smoke.mjs",
    "prototype": "vite --config vite.prototype.config.mjs",
    "prototype:build": "vite build --config vite.prototype.config.mjs",
    "companion:review": "electron scripts/companion-review.cjs",
    "board:review": "node scripts/board-review.mjs",
    "pet:test-pattern": "python3 scripts/make-pet-test-pattern.py"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@phosphor-icons/react": "^2.1.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "7.3.7",
    "esbuild": "0.28.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "rollup": "4.59.0"
  },
  "build": {
    "appId": "in.local.jarvis.desktop",
    "productName": "Desktop Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "native/**",
      "package.json",
      "!node_modules{,/**/*}",
      "!**/node_modules{,/**/*}"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asarUnpack": [
      "native/**"
    ]
  }
}
