  "statusVocabulary": ["planned"],
  "gates": {
    "G1": {
      "name": "Overlay",
      "question": "Transparent, frameless, always-on-top Electron island on Win11 at 100/150/200% DPI, multi-monitor, fullscreen-app detection",
      "passCriteria": "Expand/collapse ≤ 150 ms, no focus stealing, idle delta ≤ 40 MB",
      "status": "not-recorded",
      "blocks": [61, 63, 65, 66, 67]
    },
    "G2": {
      "name": "Local model sizing",
      "question": "Which Ollama models run on 8/16 GB RAM, no GPU",
      "passCriteria": "First token ≤ 5 s, ≥ 5 tok/s on reference laptop",
      "status": "not-recorded",
      "blocks": [11, 15, 16, 17, 18, 19]
    },
    "G3": {
      "name": "Local ASR upgrade",
      "question": "Permissively licensed Whisper-class runtime, bundled or imported offline",
      "passCriteria": "WER better than System.Speech on test set; licence MIT/Apache/BSD",
      "status": "not-recorded",
      "blocks": [12, 23, 40]
    },
    "G4": {
      "name": "Input injection",
      "question": "Reliable click/type-text across Win32/UWP/Chromium apps",
      "passCriteria": "≥ 95% on fixture matrix, never into elevated or password targets",
      "status": "not-recorded",
      "blocks": [88, 89, 90]
    },
    "G5": {
      "name": "Windows mods",
      "question": "Licence and safety of each third-party mod (Windhawk-style mods are often GPL)",
      "passCriteria": "Catalog links/launches external tools only; no bundled GPL code; reversible",
      "status": "not-recorded",
      "blocks": [71, 72, 73, 74, 75, 76, 77, 78, 79, 80]
    },
    "G6": {
      "name": "Screen capture",
      "question": "desktopCapturer region capture + local OCR (Windows.Media.Ocr via WinRT)",
      "passCriteria": "Opt-in per capture, nothing stored by default",
      "status": "not-recorded",
      "blocks": [24, 25, 29, 39, 40]
    },
    "G7": {
      "name": "Avatars/motion",
      "question": "Renderer cost of 2D/3D avatar and motion scenes",
      "passCriteria": "Within architecture §8 budget when idle; off by default",
      "status": "not-recorded",
      "blocks": [69, 70, 129, 130, 131, 132, 133, 134, 135, 136, 137, 138, 139, 140]
    },
    "G8": {
      "name": "Signing",
      "question": "Code-signing certificate and update channel",
      "passCriteria": "Signed NSIS + verified update + rollback",
      "status": "not-recorded",
      "blocks": [117]
    }
  },
